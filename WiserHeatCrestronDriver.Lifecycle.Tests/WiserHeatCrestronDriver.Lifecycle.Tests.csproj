<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><LangVersion>latest</LangVersion><Nullable>annotations</Nullable>
    <IsTestProject>true</IsTestProject><IsPackable>false</IsPackable><IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <!-- Compile the same driver and fixture sources against the SDK's desktop runtime.
       The net472 test project references the real production assembly for the processor. -->
  <Import Project="DesktopTest.Local.props" Condition="Exists('DesktopTest.Local.props')" />
  <ItemGroup>
    <Reference Include="Newtonsoft.Json.Compact" Condition="Exists('$(CompactJsonPath)')">
      <HintPath>$(CompactJsonPath)</HintPath><Private>true</Private>
    </Reference>
    <PackageReference Include="WiserHeatAPIv2" Version="1.1.2" />
    <PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="27.0.24" />
    <PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" PrivateAssets="all" />
    <Compile Include="../WiserHeatCrestronDriver/*.cs" Exclude="../WiserHeatCrestronDriver/TestAssemblyAccess.cs" Link="Driver/%(Filename)%(Extension)" />
    <Compile Include="../WiserHeatCrestronDriver/Definitions/*.cs" Link="Driver/Definitions/%(Filename)%(Extension)" />
    <Compile Include="../WiserHeatCrestronDriver.Tests/*.cs" Link="Tests/%(Filename)%(Extension)" />
    <None Include="../WiserHeatCrestronDriver/IncludeInPkg/**/*" Exclude="../WiserHeatCrestronDriver/IncludeInPkg/**/*.xsd" Link="DriverTestData/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../WiserHeatCrestronDriver/Thermostat_WiserHeat_IP_V2.json" Link="DriverTestData/DriverDefinition.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../WiserHeatCrestronDriver/Thermostat_WiserHeat_IP_V2.json" LogicalName="WiserHeat.CrestronDriver.Thermostat_WiserHeat_IP_V2.json" />
  </ItemGroup>
</Project>
