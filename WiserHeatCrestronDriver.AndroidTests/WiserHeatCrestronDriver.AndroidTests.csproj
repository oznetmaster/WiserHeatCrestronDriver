<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <TestAdapterVersion Condition="'$(TestAdapterVersion)' == ''">1.12.0</TestAdapterVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="CrestronHomeDevTools" Version="1.10.0" />
    <PackageReference Include="CrestronHomeNUnit.TestAdapter" Version="$(TestAdapterVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
