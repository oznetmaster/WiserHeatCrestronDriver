<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <IsPackable>false</IsPackable><IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="27.0.24" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
    <Reference Include="Newtonsoft.Json.Compact" Condition="Exists('$(CompactJsonPath)')">
      <HintPath>$(CompactJsonPath)</HintPath><Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
